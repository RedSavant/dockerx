{
  "name": "@RedSavant/dockerx",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.1.1",
  "description": "Interactive CLI assistant for building and running docker run commands",
  "type": "module",
  "bin": {
    "dockerx": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "publish:npmjs": "npm pkg set name=@rscomeback/dockerx && npm run build && (npm publish --registry=https://registry.npmjs.org/ --access public; code=$?; npm pkg set name=@RedSavant/dockerx; exit $code)",
    "publish:github": "npm run build && npm publish"
  },
  "keywords": [
    "docker",
    "cli",
    "interactive",
    "assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^12.1.0",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
